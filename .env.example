# official never falls back to demo. Restart after changing environment/config.
ELECTION_DATA_MODE=official
ELECTION_SOURCE_URL=https://votes26.bechirot.gov.il
ELECTION_REQUEST_TIMEOUT_MS=20000
# auto: direct fetch, then an isolated browser if the source blocks server requests.
# Local and Dockerfile.vercel defaults are auto; ordinary Vercel Functions use fetch.
ELECTION_SOURCE_TRANSPORT=auto
# WebKit successfully passes the site's normal JavaScript verification.
ELECTION_BROWSER_ENGINE=webkit
# Optional Chromium-only channel override (for ELECTION_BROWSER_ENGINE=chromium).
# ELECTION_BROWSER_CHANNEL=chrome
# Optional: defaults to .cache/elections locally, writable temporary storage on Vercel.
# ELECTION_CACHE_DIR=.cache/elections
ELECTION_STALE_AFTER_MS=180000
# When changing elections, also update src/config/election.ts (identity, roster, agreements).
